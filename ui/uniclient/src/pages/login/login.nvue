  color: #101828;
  font-size: 34rpx;
  font-weight: bold;
}
.topbar-link {
  color: #4d6bfe;
  font-size: 25rpx;
}
.form {
  flex: 1;
  padding-top: 120rpx;
}
.eyebrow {
  color: #98a2b3;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}
.title {
  margin-top: 16rpx;
  color: #101828;
  font-size: 58rpx;
  font-weight: bold;
}
.subtitle {
  margin-top: 14rpx;
  margin-bottom: 56rpx;
  color: #667085;
  font-size: 28rpx;
}
.field-label {
  margin-bottom: 12rpx;
  color: #344054;
  font-size: 25rpx;
  font-weight: bold;
}
.field-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.field-link {
  color: #4d6bfe;
  font-size: 24rpx;
}
.field {
  height: 100rpx;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #e4e7ec;
  background-color: #ffffff;
  color: #101828;
  font-size: 29rpx;
}
.field-placeholder {
  color: #98a2b3;
}
.error {
  margin-bottom: 18rpx;
  color: #d92d20;
  font-size: 25rpx;
}
.submit {
  height: 100rpx;
  margin-top: 12rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background-color: #4d6bfe;
}
.submit-off {
  background-color: #c7d2fe;
}
.submit-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}
.hint-row {
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
}
.hint-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  background-color: #12b76a;
}
.hint-text {
  color: #475467;
  font-size: 24rpx;
}
.terms {
  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 23rpx;
}
.notes {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: #f0f2f5;
}
.note {
  margin-bottom: 10rpx;
  color: #98a2b3;
  font-size: 23rpx;
}
.foot {
  height: 96rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.foot-text {
  color: #c0c5d0;
  font-size: 22rpx;
}

@media (prefers-color-scheme: dark) {
  .page {
    background-color: #12151b;
  }
  .status-spacer {
    background-color: #12151b;
  }
  .topbar {
    background-color: #12151b;
  }
  .brand-name,
  .title {
    color: #e6e9ef;
  }
  .eyebrow,
  .hint-text,
  .note,
