<template>
  <view class="page">
    <view class="brand">
      <image class="brand-logo" src="/static/shark.png" mode="aspectFit" />
      <text class="brand-name">DeepTalk</text>
    </view>

    <view class="form">
      <text class="title">{{ mode === 'login' ? '欢迎回来' : '创建账号' }}</text>
      <text class="subtitle">{{ mode === 'login' ? '登录后继续你的 DeepTalk 对话' : '注册后自动登录' }}</text>

      <input
        v-model="email"
        class="field"
        type="text"
        :placeholder="'邮箱'"
        placeholder-class="field-placeholder"
        :adjust-position="true"
      />
      <input
        v-model="password"
        class="field"
        type="password"
        :placeholder="'密码（至少 8 位）'"
        placeholder-class="field-placeholder"
        :adjust-position="true"
      />

      <text v-if="error" class="error">{{ error }}</text>

      <view class="submit" :class="{ 'submit-off': !canSubmit || loading }" @click="submit">
        <text class="submit-text">{{ loading ? '请稍候…' : mode === 'login' ? '登录' : '注册并登录' }}</text>
      </view>

      <text class="switch" @click="toggleMode">
        {{ mode === 'login' ? '还没有账号？立即注册' : '已有账号？去登录' }}
      </text>
    </view>
  </view>
</template>

<script setup>
/**
 * 登录 / 注册页。
 * H5 调试与小程序共用同一套逻辑：拿到 token 后写入本地存储。
 */
import { ref, computed } from 'vue'
import { login, register } from '@/api/auth'
import { setSession } from '@/store/session'

const mode = ref('login')
const email = ref('')
const password = ref('')
const error = ref('')
const loading = ref(false)

const canSubmit = computed(() => email.value.trim().length > 0 && password.value.length > 0)

function toggleMode() {
  mode.value = mode.value === 'login' ? 'register' : 'login'
  error.value = ''
}

async function submit() {
  if (!canSubmit.value || loading.value) return
  error.value = ''
  loading.value = true
  try {
    const data = mode.value === 'login' ? await login(email.value.trim(), password.value) : await register(email.value.trim(), password.value)
    setSession(data.token, data.user)
    uni.reLaunch({ url: '/pages/chat/chat' })
  } catch (err) {
    error.value = err?.message || '操作失败，请重试'
  } finally {
    loading.value = false
  }
}
</script>

<style>
.page {
  flex: 1;
  height: 100%;
  padding: 120rpx 56rpx 60rpx 56rpx;
  background-color: #ffffff;
}
.brand {
  flex-direction: row;
  align-items: center;
  margin-bottom: 80rpx;
}
.brand-logo {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
}
.brand-name {
  color: #101828;
  font-size: 38rpx;
  font-weight: bold;
}
.form {
  flex: 1;
}
.title {
  color: #101828;
  font-size: 52rpx;
  font-weight: bold;
}
.subtitle {
  margin-top: 16rpx;
  margin-bottom: 56rpx;
  color: #667085;
  font-size: 28rpx;
}
.field {
  height: 96rpx;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #e4e7ec;
  background-color: #f9fafc;
  color: #101828;
  font-size: 30rpx;
}
.field-placeholder {
  color: #98a2b3;
}
.error {
  margin-bottom: 20rpx;
  color: #d92d20;
  font-size: 26rpx;
}
.submit {
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background-color: #4d6bfe;
}
.submit-off {
  background-color: #c7d2fe;
}
.submit-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}
.switch {
  margin-top: 32rpx;
  text-align: center;
  color: #4d6bfe;
  font-size: 26rpx;
}
</style>
