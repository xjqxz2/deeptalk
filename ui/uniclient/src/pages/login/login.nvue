  color: #475467;
  font-size: 24rpx;
}
.terms {
  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 23rpx;
}
.notes {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: #f0f2f5;
}
.note {
  margin-bottom: 10rpx;
  color: #98a2b3;
  font-size: 23rpx;
}
.foot {
  height: 96rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.foot-text {
  color: #c0c5d0;
  font-size: 22rpx;
}

@media (prefers-color-scheme: dark) {
  .page {
    background-color: #12151b;
  }
  .status-spacer {
    background-color: #12151b;
  }
  .topbar {
    background-color: #12151b;
  }
  .brand-name,
  .title {
    color: #e6e9ef;
  }
  .eyebrow,
  .hint-text,
  .note,
  .foot-text {
    color: #7b8494;
  }
  .subtitle,
  .switch {
    color: #9aa3b2;
  }
  .field {
    background-color: #191c23;
    border-color: #2a2f3a;
    color: #e6e9ef;
  }
  .notes {
    border-top-color: #2a2f3a;
  }
}

/* 小程序授权页 */
.wx-page {
  background-color: #f7f8fa;
}
.wx-body {
  flex: 1;
  padding: 0 56rpx;
  align-items: center;
  justify-content: center;
}
.wx-logo {
  width: 168rpx;
