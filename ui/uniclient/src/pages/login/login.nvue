  margin-bottom: 28rpx;
}
.wx-title {
  color: #101828;
  font-size: 44rpx;
  font-weight: 700;
}
.wx-sub {
  margin-top: 12rpx;
  color: #667085;
  font-size: 26rpx;
}
.wx-points {
  margin-top: 48rpx;
  margin-bottom: 56rpx;
  align-items: flex-start;
}
.wx-point {
  margin-top: 12rpx;
  color: #98a2b3;
  font-size: 23rpx;
}
.wx-action {
  width: 100%;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background-color: #07c160;
}
.wx-action-off {
  opacity: 0.6;
}
.wx-action-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 650;
}
.wx-error {
  margin-top: 20rpx;
  color: #d92d20;
