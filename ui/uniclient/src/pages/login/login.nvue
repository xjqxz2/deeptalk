  font-weight: bold;
}
.field-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.field-link {
  color: #4d6bfe;
  font-size: 24rpx;
}
.field {
  height: 100rpx;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #e4e7ec;
  background-color: #ffffff;
  color: #101828;
  font-size: 29rpx;
}
