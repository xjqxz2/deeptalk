  color: #98a2b3;
}
.error {
  margin-bottom: 18rpx;
  color: #d92d20;
  font-size: 25rpx;
}
.submit {
  height: 100rpx;
  margin-top: 12rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background-color: #4d6bfe;
}
.submit-off {
  background-color: #c7d2fe;
}
