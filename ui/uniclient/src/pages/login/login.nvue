  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
}
.hint-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  background-color: #12b76a;
}
