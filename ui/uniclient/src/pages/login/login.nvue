<template>
  <!-- #ifdef H5 -->
  <LoginH5 />
  <!-- #endif -->

  <!-- #ifdef MP-WEIXIN -->
  <view class="page wx-page">
    <view class="status-spacer" :style="statusBarStyle" />
    <view class="wx-body">
      <image class="wx-logo" src="/static/logo.png" mode="aspectFit" />
      <text class="wx-title">小橘树洞</text>
      <text class="wx-sub">微信授权即可开始对话</text>

      <view class="wx-points">
        <text class="wx-point">· 一个微信账号对应一个对话空间</text>
        <text class="wx-point">· 之后可在设置里补全邮箱密码，用电脑版登录</text>
        <text class="wx-point">· 不读取你的手机号与通讯录</text>
      </view>

      <view class="wx-action" :class="{ 'wx-action-off': wxLoading }" @click="onWeChatLogin">
        <text class="wx-action-text">{{ wxLoading ? '正在授权…' : '微信一键登录' }}</text>
      </view>
      <text v-if="error" class="wx-error">{{ error }}</text>
      <text class="wx-agree">登录即表示同意《服务条款》与《隐私政策》</text>
    </view>

    <!-- 首次登录：底部浮层，可选用微信昵称头像，也可直接跳过 -->
    <view v-if="profileSheet" class="sheet-mask" @click="skipProfile">
      <view class="sheet" @click.stop>
        <text class="sheet-title">完善一下资料</text>
        <text class="sheet-sub">用微信的昵称和头像，之后在电脑端也能认出你</text>

        <button class="avatar-picker" open-type="chooseAvatar" @chooseavatar="onChooseAvatar">
          <image v-if="profileAvatar" class="avatar-img" :src="profileAvatar" mode="aspectFill" />
          <text v-else class="avatar-placeholder">选择头像</text>
        </button>

        <input
          class="sheet-input"
          type="nickname"
          placeholder="微信昵称"
          :value="profileName"
          @input="profileName = $event.detail.value"
        />

        <view class="sheet-actions">
          <text class="sheet-skip" @click="skipProfile">跳过</text>
          <view class="sheet-save" @click="saveProfileAndEnter">
            <text class="sheet-save-text">{{ savingProfile ? '保存中…' : '保存并进入' }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- #endif -->

  <!-- #ifndef H5 -->
  <!-- #ifndef MP-WEIXIN -->
  <view class="page">
    <!-- 顶部：品牌 + 注册入口 -->
    <view class="status-spacer" :style="statusBarStyle" />
    <view class="topbar">
      <view class="brand">
        <image class="brand-logo" src="/static/logo.png" mode="aspectFit" />
        <text class="brand-name">小橘树洞</text>
      </view>
      <text class="topbar-link" @click="toggleMode">
        {{ mode === 'login' ? '还没有账号？立即注册' : '已有账号？去登录' }}
      </text>
    </view>

    <view class="form">
      <text class="eyebrow">ACCOUNT ACCESS</text>
      <text class="title">{{ mode === 'login' ? '欢迎回来' : '创建账号' }}</text>
      <text class="subtitle">{{ mode === 'login' ? '登录后继续你的 小橘树洞 工作台。' : '注册后自动登录，立即开始对话。' }}</text>

      <text class="field-label">邮箱</text>
      <input
        v-model="email"
        class="field"
        type="text"
        placeholder="you@company.com"
        placeholder-class="field-placeholder"
        :adjust-position="true"
      />

      <view class="field-head">
        <text class="field-label">密码</text>
        <text class="field-link" @click="onForgot">忘记密码？</text>
      </view>
      <input
        v-model="password"
        class="field"
        type="password"
        :placeholder="mode === 'login' ? '请输入密码' : '至少 8 位，建议含字母与数字'"
        placeholder-class="field-placeholder"
        :adjust-position="true"
      />

      <text v-if="error" class="error">{{ error }}</text>

      <view class="submit" :class="{ 'submit-off': !canSubmit || loading }" @click="submit">
        <text class="submit-text">{{ loading ? '请稍候…' : mode === 'login' ? '登录' : '注册并登录' }}</text>
      </view>

      <view class="hint-row">
        <view class="hint-dot" />
        <text class="hint-text">{{ mode === 'login' ? '登录后进入你的对话空间' : '注册后自动登录' }}</text>
      </view>

      <text class="terms">登录即表示同意《服务条款》与《隐私政策》</text>

      <view class="notes">
        <text class="note">· 无需验证邮件，忘记密码可由管理员重置</text>
        <text class="note">· 全程 HTTPS，会话保存在本地，可随时退出</text>
      </view>
    </view>

    <view class="foot">
      <text class="foot-text">© 2026 小橘树洞</text>
      <text class="foot-text">隐私 · 条款</text>
    </view>
  </view>
  <!-- #endif -->
  <!-- #endif -->
</template>

<script setup>
/**
 * 登录 / 注册页，布局对齐 PWA 手机端：
 * 左上品牌、右上注册入口、左对齐标题、带标签的输入框与底部说明。
 */
import { ref, computed, onMounted } from 'vue'
import { onReady } from '@dcloudio/uni-app'
import { login, register, wechatLogin, updateProfile } from '@/api/auth'
// #ifdef H5
import LoginH5 from '@/components/h5/login.vue'
// #endif
import { setSession, isLoggedIn } from '@/store/session'
import { goChat as goChatPage } from '@/utils/nav'

const mode = ref('login')
const email = ref('')
const password = ref('')
const error = ref('')
const loading = ref(false)
const wxLoading = ref(false)
const profileSheet = ref(false)
const profileName = ref('')
const profileAvatar = ref('')
const savingProfile = ref(false)

/** 微信头像选择（button open-type=chooseAvatar 回调）。 */
function onChooseAvatar(event) {
  const url = event?.detail?.avatarUrl
  if (url) profileAvatar.value = url
}

/** 跳过：直接用系统默认昵称进入聊天。 */
function skipProfile() {
  profileSheet.value = false
  goChatPage()
}

/** 保存昵称头像后进入聊天。 */
async function saveProfileAndEnter() {
  if (savingProfile.value) return
  savingProfile.value = true
  try {
    if (profileName.value.trim() || profileAvatar.value) {
      await updateProfile({ nickname: profileName.value.trim(), avatar_url: profileAvatar.value })
    }
    profileSheet.value = false
    goChatPage()
  } catch (err) {
    error.value = err?.message || '保存失败，可先跳过'
  } finally {
    savingProfile.value = false
  }
}

const canSubmit = computed(() => email.value.trim().length > 0 && password.value.length > 0)

// 自定义导航栏：小程序端要给状态栏留出高度
const statusBarHeight = ref(0)
const statusBarStyle = computed(() => `height:${statusBarHeight.value || 0}px;`)

onReady(() => {
  // 已经有登录态就直接进聊天页
  if (isLoggedIn()) goChatPage()
})

onMounted(() => {
  // #ifndef H5
  try {
    statusBarHeight.value = uni.getSystemInfoSync().statusBarHeight || 20
  } catch {
    /* 忽略 */
  }
  // #endif
})

function toggleMode() {
  mode.value = mode.value === 'login' ? 'register' : 'login'
  error.value = ''
}

/** 忘记密码：没有自助重置入口，提示联系管理员。 */
function onForgot() {
  uni.showModal({
    title: '忘记密码',
    content: '当前版本暂不支持自助找回，请联系管理员重置密码。',
    showCancel: false,
  })
}

/** 小程序端：wx.login 换 code，后端建号/登录后直接进聊天。 */
async function onWeChatLogin() {
  if (wxLoading.value) return
  wxLoading.value = true
  error.value = ''
  try {
    const code = await new Promise((resolve, reject) => {
      uni.login({
        provider: 'weixin',
        success: (res) => (res.code ? resolve(res.code) : reject(new Error('未获取到微信授权码'))),
        fail: () => reject(new Error('微信授权失败，请重试')),
      })
    })
    const data = await wechatLogin(code)
    setSession(data.token, data.user)
    profileName.value = data.user?.nickname || ''
    profileAvatar.value = data.user?.avatar_url || ''
    // 首次登录不跳中间页：在底部浮层里让用户决定用不用微信昵称/头像
    if (data.user?.email_placeholder) {
      profileSheet.value = true
      return
    }
    goChatPage()
  } catch (err) {
    error.value = err?.message || '登录失败，请重试'
  } finally {
    wxLoading.value = false
  }
}

async function submit() {
  if (!canSubmit.value || loading.value) return
  error.value = ''
  loading.value = true
  try {
    const data = mode.value === 'login' ? await login(email.value.trim(), password.value) : await register(email.value.trim(), password.value)
    setSession(data.token, data.user)
    goChatPage()
  } catch (err) {
    error.value = err?.message || '操作失败，请重试'
  } finally {
    loading.value = false
  }
}
</script>

<style>
.page {
  flex: 1;
  height: 100%;
  padding: 0 48rpx;
  background-color: #ffffff;
}
.status-spacer {
  flex-shrink: 0;
  background-color: #ffffff;
}
