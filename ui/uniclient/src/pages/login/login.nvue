}
.wx-agree {
  margin-top: 28rpx;
  color: #b0b7c3;
  font-size: 21rpx;
}
@media (prefers-color-scheme: dark) {
  .wx-page {
    background-color: #12151b;
  }
  .wx-title {
    color: #e6e9ef;
  }
  .wx-sub,
  .wx-point,
  .wx-agree {
    color: #7b8494;
  }
}

/* 首次登录的底部浮层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(16, 24, 40, 0.45);
  justify-content: flex-end;
}
.sheet {
  padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  background-color: #ffffff;
}
.sheet-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: bold;
}
.sheet-sub {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
}
.avatar-picker {
  margin-top: 28rpx;
  width: 128rpx;
  height: 128rpx;
  align-items: center;
  justify-content: center;
  border-radius: 64rpx;
  background-color: #f2f4f7;
  overflow: hidden;
}
.avatar-img {
  width: 128rpx;
  height: 128rpx;
}
.avatar-placeholder {
  color: #98a2b3;
  font-size: 21rpx;
}
.sheet-input {
  margin-top: 24rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background-color: #f7f8fa;
  color: #101828;
  font-size: 27rpx;
}
.sheet-actions {
  margin-top: 36rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
