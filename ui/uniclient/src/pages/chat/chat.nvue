<template>
  <view class="page">
    <!-- 顶栏 -->
    <view class="topbar">
      <text class="topbar-menu" @click="drawerOpen = true">☰</text>
      <text class="topbar-title">{{ currentTitle }}</text>
      <text class="topbar-action" @click="onShare">分享</text>
    </view>

    <!-- 消息列表 -->
    <scroll-view
      class="messages"
      scroll-y
      :scroll-into-view="scrollTarget"
      :scroll-with-animation="true"
      @scrolltoupper="loadMore"
    >
      <view v-if="!chat.messages.length" class="empty">
        <image class="empty-logo" src="/static/shark.png" mode="aspectFit" />
        <text class="empty-title">我是 DeepTalk，很高兴见到你！</text>
        <text class="empty-hint">可以问问题、读文档，也能一起头脑风暴。</text>
      </view>

      <view v-for="(item, index) in chat.messages" :id="`msg-${index}`" :key="item.id || index">
        <MessageItem
          :message="item"
          :activity="chat.activity"
          @regenerate="onRegenerate"
          @rate="(rating) => onRate(item, rating)"
          @retry="onRegenerate"
        />
      </view>
      <view id="msg-end" class="list-end" />
    </scroll-view>

    <!-- 输入框 -->
    <Composer
      v-model="draft"
      :generating="chat.generating"
      :model-name="modelName"
      @send="onSend"
      @stop="onStop"
      @attach="pickImage"
      @pick-model="pickModel"
    />

    <!-- H5 端模型选择：Vant Popup + Picker（小程序与 APP 用原生 ActionSheet） -->
    <!-- #ifdef H5 -->
    <van-popup v-model:show="modelPickerOpen" position="bottom" round>
      <van-picker
        :columns="modelColumns"
        title="选择模型"
        @confirm="onModelConfirm"
        @cancel="modelPickerOpen = false"
      />
    </van-popup>
    <!-- #endif -->

    <!-- 历史会话抽屉 -->
    <view v-if="drawerOpen" class="drawer-mask" @click="drawerOpen = false">
      <view class="drawer" @click.stop>
        <view class="drawer-head">
          <text class="drawer-title">历史对话</text>
          <text class="drawer-new" @click="newChat">＋ 新建</text>
        </view>
        <scroll-view class="drawer-list" scroll-y>
          <view
            v-for="item in chat.conversations"
            :key="item.id"
            class="drawer-item"
            :class="{ 'drawer-item-on': chat.current && chat.current.id === item.id }"
            @click="openItem(item)"
            @longpress="onItemLongPress(item)"
          >
            <text class="drawer-item-title">{{ item.title }}</text>
          </view>
          <text v-if="!chat.conversations.length" class="drawer-empty">还没有对话</text>
        </scroll-view>
        <view class="drawer-foot" @click="logout">
          <text class="drawer-foot-text">退出登录</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup>
/**
 * 聊天主页面：消息流、输入框、历史会话抽屉。
 * 生成走 WebSocket；与 Web 端共享同一套后端接口与事件。
 */
import { computed, ref, nextTick, onMounted, onUnmounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import MessageItem from '@/components/message-item.nvue'
import Composer from '@/components/composer.nvue'
import {
  chat,
  currentTitle,
  loadConversations,
  loadModels,
  openConversation,
  startDraft,
  send,
  stop,
  regenerate,
  rate,
  shareCurrent,
  removeConversation,
  rename,
  selectModel,
} from '@/store/chat'
import { chatSocket } from '@/utils/ws'
import { uploadFile } from '@/api/http'
import { clearSession } from '@/store/session'
import { toast, confirm } from '@/utils/ui'
import { logout as logoutApi } from '@/api/auth'

const draft = ref('')
const drawerOpen = ref(false)
const scrollTarget = ref('')
const attachments = ref([])

const modelName = computed(() => chat.models.find((item) => item.id === chat.modelId)?.display_name || '选择模型')
const modelPickerOpen = ref(false)
const modelColumns = computed(() => chat.models.map((item) => ({ text: item.display_name, value: item.id })))

function scrollToBottom() {
  nextTick(() => {
    scrollTarget.value = ''
    setTimeout(() => {
      scrollTarget.value = 'msg-end'
    }, 30)
  })
}

async function onSend() {
  const content = draft.value
  if (chat.generating) return
  if (!content.trim() && !attachments.value.length) return
  draft.value = ''
  try {
    await send(content, attachments.value.map((item) => item.id))
    attachments.value = []
    scrollToBottom()
  } catch (err) {
    toast(err?.message || '发送失败')
  }
}

function onStop() {
  stop()
}

function onRegenerate() {
  regenerate()
  scrollToBottom()
}

async function onRate(message, rating) {
  try {
    await rate(message, rating)
  } catch {
    toast('操作失败')
  }
}

function newChat() {
  startDraft()
  drawerOpen.value = false
}

async function openItem(item) {
  drawerOpen.value = false
  await openConversation(item.public_id || item.id)
  scrollToBottom()
}

function onItemLongPress(item) {
  uni.showActionSheet({
    itemList: ['重命名', '删除'],
    success: async (res) => {
      if (res.tapIndex === 1) {
        const ok = await confirm('删除对话', `确定删除「${item.title}」吗？`)
        if (!ok) return
        await removeConversation(item.id)
        toast('已删除')
        return
      }
      uni.showModal({
        title: '重命名',
        editable: true,
        placeholderText: item.title,
        success: async (input) => {
          if (!input.confirm || !input.content) return
          await rename(item.id, input.content)
        },
      })
    },
  })
}

function pickImage() {
  uni.chooseImage({
    count: 4,
    success: async (res) => {
      for (const path of res.tempFilePaths) {
        try {
          const attachment = await uploadFile(path)
          attachments.value.push(attachment)
          toast('图片已添加')
        } catch (err) {
          toast(err.message || '上传失败')
        }
      }
    },
  })
}

function pickModel() {
  if (!chat.models.length) {
    toast('暂无可用模型')
    return
  }
  // #ifdef H5
  modelPickerOpen.value = true
  // #endif
  // #ifndef H5
  uni.showActionSheet({
    itemList: chat.models.map((item) => item.display_name),
    success: (res) => {
      selectModel(chat.models[res.tapIndex].id)
    },
  })
  // #endif
}

/** H5 端 Vant Picker 确认。 */
function onModelConfirm({ selectedOptions }) {
  const picked = selectedOptions?.[0]
  if (picked) selectModel(picked.value)
  modelPickerOpen.value = false
}

async function onShare() {
  if (!chat.current?.public_id) {
    toast('先聊两句再分享')
    return
  }
  try {
    const url = await shareCurrent()
    toast(url ? '分享链接已复制' : '分享失败')
  } catch {
    toast('分享失败')
  }
}

async function logout() {
  try {
    await logoutApi()
  } catch {
    // 忽略登出接口异常，本地清理即可
  }
  chatSocket.close()
  clearSession()
  drawerOpen.value = false
  uni.reLaunch({ url: '/pages/login/login' })
}

function loadMore() {
  // 占位：历史消息分页由服务端一次返回
}

onMounted(async () => {
  chatSocket.connect()
  await Promise.all([loadModels(), loadConversations()])
  if (chat.conversations.length) {
    await openItem(chat.conversations[0])
  }
})

onShow(() => {
  chatSocket.connect()
})

onUnmounted(() => {
  chatSocket.close()
})
</script>

<style>
.page {
  flex: 1;
  height: 100%;
  background-color: #ffffff;
}
.topbar {
  height: 100rpx;
  flex-direction: row;
  align-items: center;
  padding: 0 28rpx;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: #f0f2f5;
  background-color: #ffffff;
}
.topbar-menu {
  width: 60rpx;
  color: #475467;
  font-size: 34rpx;
}
.topbar-title {
  flex: 1;
  color: #101828;
  font-size: 30rpx;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}
.topbar-action {
  margin-left: 20rpx;
  color: #4d6bfe;
  font-size: 26rpx;
}
.messages {
  flex: 1;
  background-color: #ffffff;
}
.empty {
  padding: 140rpx 60rpx;
  align-items: center;
}
.empty-logo {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 28rpx;
}
.empty-title {
  color: #101828;
  font-size: 38rpx;
  font-weight: bold;
  text-align: center;
}
.empty-hint {
  margin-top: 16rpx;
  color: #98a2b3;
  font-size: 26rpx;
  text-align: center;
}
.list-end {
  height: 24rpx;
}
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(16, 24, 40, 0.35);
}
.drawer {
  width: 560rpx;
  height: 100%;
  background-color: #ffffff;
}
.drawer-head {
  height: 120rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: #f0f2f5;
}
.drawer-title {
  color: #101828;
  font-size: 30rpx;
  font-weight: bold;
}
.drawer-new {
  color: #4d6bfe;
  font-size: 26rpx;
}
.drawer-list {
  flex: 1;
}
.drawer-item {
  padding: 26rpx 28rpx;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: #f7f8fa;
}
.drawer-item-on {
  background-color: #eef2ff;
}
.drawer-item-title {
  color: #101828;
  font-size: 27rpx;
  lines: 1;
  text-overflow: ellipsis;
}
.drawer-empty {
  padding: 40rpx 28rpx;
  color: #98a2b3;
  font-size: 26rpx;
}
.drawer-foot {
  height: 100rpx;
  align-items: center;
  justify-content: center;
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: #f0f2f5;
}
.drawer-foot-text {
  color: #d92d20;
  font-size: 27rpx;
}
</style>
