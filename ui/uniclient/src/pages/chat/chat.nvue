<template>
  <!-- #ifdef H5 -->
  <div class="chat-session h5-parity">
    <ChatTopbarH5 :title="currentTitle" :initial="avatarText" @menu="drawerOpen = true" @account="onAvatar" />

    <div ref="scroller" class="messages-scroll">
      <div class="messages-column">
        <div v-if="!chat.messages.length" class="empty-session">
          <BrandMarkH5 :size="56" :radius="16" />
          <p>我是 小橘树洞，很高兴见到你！</p>
          <span>可以问问题、读文档，也能一起头脑风暴。</span>
        </div>
        <MessageH5
          v-for="(item, index) in chat.messages"
          :key="item.id || index"
          :message="item"
          :busy="chat.generating"
          :activity="chat.activity"
          @regenerate="onRegenerate"
          @rate="(rating) => onRate(item, rating)"
          @retry="onRegenerate"
          @a2ui-action="onA2uiAction"
        />
      </div>
    </div>

    <div class="composer-dock">
      <div class="composer-inner">
        <ComposerH5
          ref="composerRef"
          v-model="draft"
          :generating="chat.generating"
          :model-name="modelName"
          :attachments="attachments"
          @send="onSend"
          @stop="onStop"
          @attach="pickImage"
          @pick-model="pickModel"
          @remove-attachment="removeAttachment"
        />
      </div>
    </div>

    <SidebarH5
      v-if="drawerOpen"
      :conversations="chat.conversations"
      :current-id="chat.current && chat.current.id"
      :keyword="keyword"
      :initial="avatarText"
      :account-name="accountName"
      :account-mail="accountMail"
      :usage="chat.usage"
      @close="drawerOpen = false"
      @new="newChat"
      @search="onSearch"
      @open="openItem"
      @actions="onItemLongPress"
      @account="onAvatar"
    />

    <van-popup v-model:show="modelPickerOpen" position="bottom" round>
      <van-picker
        :columns="modelColumns"
        title="选择模型"
        @confirm="onModelConfirm"
        @cancel="modelPickerOpen = false"
      />
    </van-popup>
  </div>
  <!-- #endif -->

  <!-- #ifndef H5 -->
  <view class="page">
    <!-- 顶栏 -->
    <view class="status-spacer" :style="statusBarStyle" />
    <view class="topbar">
      <view class="topbar-menu" @click="drawerOpen = true">
        <view class="bar" />
        <view class="bar" />
        <view class="bar" />
      </view>
      <text class="topbar-title">{{ currentTitle }}</text>
      <view class="topbar-avatar" :style="avatarStyle" @click="onAvatar">
        <text class="topbar-avatar-text">{{ avatarText }}</text>
      </view>
    </view>

    <!-- 运行错误提示：出现未捕获异常时不要只留白屏 -->
    <view v-if="errorState.message" class="err-bar">
      <text class="err-text">{{ errorState.message }}</text>
      <text class="err-close" @click="onClearError">关闭</text>
    </view>

    <!-- 消息列表 -->
    <scroll-view
      class="messages"
      scroll-y
      enable-flex
      :scroll-into-view="scrollTarget"
      :scroll-with-animation="true"
      @scrolltoupper="loadMore"
    >
      <view v-if="!chat.messages.length" class="empty">
        <image class="empty-logo" src="/static/logo.png" mode="aspectFit" />
        <text class="empty-title">我是 小橘树洞，很高兴见到你！</text>
        <text class="empty-hint">可以问问题、读文档，也能一起头脑风暴。</text>
      </view>

      <view class="list-inner">
      <view v-for="(item, index) in chat.messages" :id="`msg-${index}`" :key="item.id || index">
        <MessageItem
          :message="item"
          :activity="chat.activity"
          @regenerate="onRegenerate"
          @rate="(rating) => onRate(item, rating)"
          @retry="onRegenerate"
          @a2ui-action="onA2uiAction"
        />
      </view>
      <view id="msg-end" class="list-end" />
      </view>
    </scroll-view>

    <!-- 输入框 -->
    <view class="composer-wrap">
    <Composer
      v-model="draft"
      :generating="chat.generating"
      :model-name="modelName"
      @send="onSend"
      @stop="onStop"
      @attach="pickImage"
      @pick-model="pickModel"
    />
    </view>

    <!-- H5 端模型选择：Vant Popup + Picker（小程序与 APP 用原生 ActionSheet） -->
    <!-- #ifdef H5 -->
    <van-popup v-model:show="modelPickerOpen" position="bottom" round>
      <van-picker
        :columns="modelColumns"
        title="选择模型"
        @confirm="onModelConfirm"
        @cancel="modelPickerOpen = false"
      />
    </van-popup>
    <!-- #endif -->

    <!-- 历史会话抽屉 -->
    <view v-if="drawerOpen" class="drawer-mask" @click="drawerOpen = false">
      <view class="drawer" @click.stop>
        <view class="drawer-head">
          <image class="drawer-logo" src="/static/logo.png" mode="aspectFit" />
          <text class="drawer-brand">小橘树洞</text>
          <view class="drawer-collapse" @click="drawerOpen = false">
            <view class="bar" />
            <view class="bar" />
          </view>
        </view>

        <view class="drawer-new" @click="newChat">
          <text class="drawer-new-plus">＋</text>
          <text class="drawer-new-text">新建对话</text>
        </view>

        <view class="drawer-search">
          <view class="drawer-search-icon">
            <view class="search-ring" />
            <view class="search-handle" />
          </view>
          <input
            v-model="keyword"
            class="drawer-search-input"
            placeholder="搜索对话"
            placeholder-class="drawer-search-placeholder"
            confirm-type="search"
            @confirm="onSearch"
          />
        </view>

        <scroll-view class="drawer-list" scroll-y>
          <text v-if="chat.conversations.length" class="drawer-group">今天</text>
          <view
            v-for="item in chat.conversations"
            :key="item.id"
            class="drawer-item"
            :class="{ 'drawer-item-on': chat.current && chat.current.id === item.id }"
            @click="openItem(item)"
            @longpress="onItemLongPress(item)"
          >
            <view class="drawer-item-dot" />
            <text class="drawer-item-title">{{ item.title }}</text>
            <view class="dots" @click.stop="onItemLongPress(item)">
              <view class="dot" />
              <view class="dot" />
              <view class="dot" />
            </view>
          </view>
          <text v-if="!chat.conversations.length" class="drawer-empty">还没有对话</text>
        </scroll-view>

        <view class="drawer-usage">
          <view class="drawer-usage-head">
            <text class="drawer-usage-title">{{ planName }}</text>
            <text class="drawer-usage-percent">本月</text>
          </view>

          <view v-if="limits" class="drawer-limits">
            <view class="drawer-limit-row">
              <text class="drawer-limit-label">本月消费</text>
              <text class="drawer-limit-value">¥{{ spend }} / ¥{{ spendLimit }}</text>
            </view>
            <view class="drawer-limit-row">
              <text class="drawer-limit-label">5 小时 / 本周 / 本月</text>
              <text class="drawer-limit-value">{{ limits.requests_short }} / {{ limits.requests_week }} / {{ limits.requests_month }}</text>
            </view>
          </view>
        </view>

        <view class="drawer-account" @click="onAvatar">
          <view class="drawer-avatar">
            <text class="drawer-avatar-text">{{ avatarText }}</text>
          </view>
          <view class="drawer-account-main">
            <text class="drawer-account-name">{{ accountName }}</text>
            <text class="drawer-account-mail">{{ accountMail }}</text>
          </view>
          <view class="dots">
            <view class="dot" />
            <view class="dot" />
            <view class="dot" />
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- #endif -->
</template>

<script setup>
/**
 * 聊天主页面：消息流、输入框、历史会话抽屉。
 * 生成走 WebSocket；与 Web 端共享同一套后端接口与事件。
 */
import { computed, ref, nextTick, onMounted } from 'vue'
import { onLoad, onReady, onShow } from '@dcloudio/uni-app'
import MessageItem from '@/components/message-item.nvue'
import Composer from '@/components/composer.nvue'

// #ifdef H5
import ChatTopbarH5 from '@/components/h5/topbar.vue'
import MessageH5 from '@/components/h5/message.vue'
import ComposerH5 from '@/components/h5/composer.vue'
import SidebarH5 from '@/components/h5/sidebar.vue'
import BrandMarkH5 from '@/components/h5/brand-mark.vue'
// #endif
import {
  chat,
  currentTitle,
  loadConversations,
  loadModels,
  loadUsage,
  openConversation,
  startDraft,
  send,
  stop,
  regenerate,
  rate,
  shareCurrent,
  removeConversation,
  rename,
  selectModel,
} from '@/store/chat'
import { chatSocket } from '@/utils/ws'
import { uploadFile } from '@/api/http'
import { session, clearSession, isLoggedIn, getSignKey } from '@/store/session'
import { goLogin } from '@/utils/nav'
import { errorState, clearError as clearPageError } from '@/utils/errors'
import { toast, confirm } from '@/utils/ui'
import { logout as logoutApi, bindWeChat, fetchSignKey } from '@/api/auth'

const draft = ref('')
const keyword = ref('')
const composerRef = ref(null)
const scroller = ref(null)
// 自定义导航栏：需要自己给状态栏留高度，并避开右上角的胶囊按钮
const statusBarHeight = ref(0)
const capsuleInset = ref(0)
// 状态栏占位：拿不到系统值时按 20px 兜底，避免内容压到状态栏上
const statusBarStyle = computed(() => `height:${statusBarHeight.value || 0}px;`)
const avatarStyle = computed(() => (capsuleInset.value ? `margin-right:${capsuleInset.value}px;` : ''))
const drawerOpen = ref(false)
const scrollTarget = ref('')
const attachments = ref([])

const modelName = computed(() => chat.models.find((item) => item.id === chat.modelId)?.display_name || '选择模型')
const modelPickerOpen = ref(false)
const modelColumns = computed(() => chat.models.map((item) => ({ text: item.display_name, value: item.id })))

const avatarText = computed(() => session.user?.avatar_text || session.user?.nickname?.slice(0, 1) || 'U')
const accountName = computed(() => session.user?.nickname || '用户')
const accountMail = computed(() => session.user?.email || '')

const planName = computed(() => chat.usage?.limits?.plan?.name || '免费版')
const limits = computed(() => chat.usage?.limits || null)
const spend = computed(() => ((limits.value?.spend_cents || 0) / 100).toFixed(2))
const spendLimit = computed(() => ((limits.value?.spend_limit_cents || 0) / 100).toFixed(2))





/** 打开某个会话（抽屉点击 / 首屏自动恢复）。 */
async function openItem(item) {
  drawerOpen.value = false
  await openConversation(item.public_id || item.id)
  scrollToBottom()
}

/** 新建对话：清空当前草稿与消息。 */
function newChat() {
  startDraft()
  drawerOpen.value = false
  draft.value = ''
  attachments.value = []
}

/** 会话搜索：交给服务端按标题模糊查询。 */
async function onSearch() {
  await loadConversations(keyword.value.trim())
}

/** 会话长按 / 更多：重命名、分享、删除。 */
function onItemLongPress(item) {
  const actions = ['重命名', '分享链接', '删除']
  uni.showActionSheet({
    itemList: actions,
    success: async (res) => {
      if (res.tapIndex === 0) {
        uni.showModal({
          title: '重命名',
          editable: true,
          placeholderText: item.title,
          success: async (input) => {
            const title = String(input?.content || '').trim()
            if (input?.confirm && title) await rename(item.id, title)
          },
        })
      } else if (res.tapIndex === 1) {
        const url = await shareCurrent()
        if (url) uni.showToast({ title: '分享链接已复制', icon: 'none' })
      } else if (res.tapIndex === 2) {
        const ok = await confirm({ title: '删除对话', content: `确定删除「${item.title}」？`, danger: true })
        if (ok) await removeConversation(item.id)
      }
    },
  })
}

/** 头像 / 账号入口：退出登录、切换账号。 */
function onAvatar() {
  uni.showActionSheet({
    itemList: ['退出登录'],
    success: async (res) => {
      if (res.tapIndex !== 0) return
      try {
        await logoutApi()
      } finally {
        clearSession()
        drawerOpen.value = false
        goLogin()
      }
    },
  })
}

/** 重新生成上一条回答。 */
function onRegenerate() {
  regenerate()
}

/** 模型选择确认（H5 的 van-picker）。 */
function onModelConfirm(payload) {
  const value = payload?.detail?.value ?? payload?.value
  const id = typeof value === 'object' ? value?.value ?? value?.id : value
  if (id) selectModel(Number(id))
  modelPickerOpen.value = false
}

/** 移除待发送的附件。 */
function removeAttachment(item) {
  attachments.value = attachments.value.filter((entry) => entry.id !== item.id)
}

/** 上拉加载更早的消息（当前一次性加载，保留入口避免报错）。 */
function loadMore() {
  // 消息一次性加载，暂不做分页；保留空实现以兼容模板绑定
}

/**
 * 读取状态栏高度与胶囊位置，只有小程序 / APP 需要。
 * 自定义导航栏下页面从 y=0 开始，必须自己给状态栏留白。
 */
function measureChrome() {
  // #ifndef H5
  try {
    const info = uni.getSystemInfoSync()
    statusBarHeight.value = info.statusBarHeight || 20
    if (typeof uni.getMenuButtonBoundingClientRect === 'function') {
      const capsule = uni.getMenuButtonBoundingClientRect()
      if (capsule && capsule.left) {
        capsuleInset.value = Math.max(0, (info.windowWidth || info.screenWidth) - capsule.left + 8)
      }
    }
  } catch {
    statusBarHeight.value = 20
  }
  // #endif
}

/**
 * 小程序端把 wx.login 的 code 换成 openid 并绑定到当前账号：
 * 微信的文本内容安全接口（msgSecCheck v2）要求带 openid。
 */
function bindWeChatOpenID() {
  // #ifdef MP-WEIXIN
  uni.login({
    provider: 'weixin',
    success: (res) => {
      if (!res.code) return
      bindWeChat(res.code).catch(() => {
        // 绑定失败不阻断使用，服务端会按策略降级
      })
    },
  })
  // #endif
}

/** 发送当前输入；生成中则由 store 转成插话。 */
async function onSend() {
  const text = draft.value.trim()
  const ids = attachments.value.map((item) => item.id)
  if (!text && !ids.length) return
  draft.value = ''
  const pending = attachments.value
  attachments.value = []
  try {
    await send(text, ids)
    scrollToBottom()
  } catch (err) {
    // 发送失败把内容还给用户
    draft.value = text
    attachments.value = pending
    toast(err?.message || '发送失败，请重试')
  }
}

/** 停止当前生成。 */
function onStop() {
  stop()
}

/** 选择图片并上传，作为本轮消息的附件。 */
async function pickImage() {
  const picked = await new Promise((resolve) => {
    uni.chooseImage({ count: 1, sizeType: ['compressed'], success: resolve, fail: () => resolve(null) })
  })
  const path = picked?.tempFilePaths?.[0]
  if (!path) return
  try {
    const asset = await uploadFile(path)
    attachments.value = [...attachments.value, asset]
  } catch (err) {
    toast(err?.message || '图片上传失败')
  }
}

/** 选择模型：H5 用 van-picker，小程序与 APP 用原生 ActionSheet。 */
function pickModel() {
  // #ifdef H5
  modelPickerOpen.value = true
  // #endif
  // #ifndef H5
  if (!chat.models.length) {
    toast('管理员还没有配置可用模型')
    return
  }
  uni.showActionSheet({
    itemList: chat.models.map((item) => item.display_name),
    success: (res) => selectModel(chat.models[res.tapIndex].id),
  })
  // #endif
}

/** 滚到底部：消息列表使用 scroll-into-view，target 变化才会触发。 */
function scrollToBottom() {
  nextTick(() => {
    scrollTarget.value = ''
    nextTick(() => {
      scrollTarget.value = 'msg-end'
    })
  })
}

// 首帧之前量好状态栏与胶囊，避免内容先画到状态栏上再跳一下
onLoad(() => {
  measureChrome()
  if (isLoggedIn() && !getSignKey()) {
    fetchSignKey().catch(() => {})
  }
})

onReady(() => {
  if (!isLoggedIn()) goLogin()
})

onMounted(async () => {
  bindWeChatOpenID()
  // 没登录就不发任何请求：否则会同时打出 3 个 401，进而触发多次跳转
  if (!isLoggedIn()) return
  chatSocket.connect()
  await Promise.all([loadModels(), loadConversations(), loadUsage()])
  if (chat.conversations.length) {
    await openItem(chat.conversations[0])
  }
})

onShow(() => {
  chatSocket.connect()
})
</script>

<style>
.page {
  flex: 1;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background-color: #ffffff;
}
.status-spacer {
  flex-shrink: 0;
  background-color: #ffffff;
}
.topbar {
  height: 96rpx;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx 0 32rpx;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: #eaecf0;
  background-color: #ffffff;
}
.topbar-menu {
  width: 56rpx;
  padding: 8rpx 0;
}
.bar {
  width: 34rpx;
  height: 3rpx;
  margin: 5rpx 0;
  border-radius: 2rpx;
  background-color: #475467;
}
.topbar-title {
  flex: 1;
  color: #101828;
  font-size: 27rpx;
  font-weight: 650;
  letter-spacing: -0.2rpx;
  lines: 1;
  text-overflow: ellipsis;
}
.topbar-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 32rpx;
  align-items: center;
  justify-content: center;
  background-color: #eef2ff;
}
.topbar-avatar-text {
  color: #4d6bfe;
  font-size: 28rpx;
  font-weight: bold;
}

/* 微信右上角是胶囊按钮，头像会叠上去；账号入口保留在侧栏底部 */
/* #ifdef MP-WEIXIN */
.topbar-avatar {
  display: none;
}
/* #endif */
/* 微信的 scroll-view 需要可收缩高度：height:0 + flex:1 才能把输入框留在屏幕内 */
.messages {
  flex: 1;
  height: 0;
  min-height: 0;
  background-color: #ffffff;
}
.empty {
  padding: 160rpx 60rpx;
  align-items: center;
}
.empty-logo {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 32rpx;
}
.empty-title {
  color: #101828;
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
}
.empty-hint {
  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 26rpx;
  text-align: center;
}
.list-end {
  height: 24rpx;
}
/* 宽屏（H5 桌面浏览器调试）下收窄成手机列宽，避免整行拉满 */
.list-inner {
  width: 100%;
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
  padding: 16rpx 32rpx 12rpx 32rpx;
}
.composer-wrap {
  width: 100%;
  max-width: 760px;
  flex-shrink: 0;
  margin-left: auto;
  margin-right: auto;
}
.err-bar {
  flex-direction: row;
  align-items: center;
  padding: 14rpx 24rpx;
  background-color: #fef3f2;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: #fecdca;
}
.err-text {
  flex: 1;
  color: #b42318;
  font-size: 24rpx;
}
.err-close {
  margin-left: 16rpx;
  color: #b42318;
  font-size: 24rpx;
}
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(16, 24, 40, 0.35);
}
.drawer {
  width: 606rpx;
  height: 100%;
  background-color: #ffffff;
  border-right-width: 1rpx;
  border-right-style: solid;
  border-right-color: #f0f2f5;
}
.drawer-head {
  height: 128rpx;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}
.drawer-logo {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
}
.drawer-brand {
  flex: 1;
  color: #101828;
  font-size: 32rpx;
  font-weight: bold;
}
.drawer-collapse {
  width: 44rpx;
  padding: 10rpx 0;
  align-items: flex-end;
}
.drawer-new {
  height: 84rpx;
  flex-direction: row;
  align-items: center;
  margin: 8rpx 24rpx 0 24rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #e4e7ec;
}
.drawer-new-plus {
  margin-right: 12rpx;
  color: #475467;
  font-size: 30rpx;
}
.drawer-new-text {
  color: #101828;
  font-size: 28rpx;
}
.drawer-search {
  height: 84rpx;
  flex-direction: row;
  align-items: center;
  margin: 16rpx 24rpx 0 24rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #e4e7ec;
}
.drawer-search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
}
.search-ring {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #98a2b3;
}
.search-handle {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  width: 10rpx;
