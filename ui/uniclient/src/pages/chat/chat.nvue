  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 26rpx;
  text-align: center;
}
.list-end {
  height: 24rpx;
}
/* 宽屏（H5 桌面浏览器调试）下收窄成手机列宽，避免整行拉满 */
.list-inner {
  width: 100%;
