<template>
  <view class="page">
    <!-- 顶栏 -->
    <view class="topbar">
      <view class="topbar-menu" @click="drawerOpen = true">
        <view class="bar" />
        <view class="bar" />
        <view class="bar" />
      </view>
      <text class="topbar-title">{{ currentTitle }}</text>
      <view class="topbar-avatar" @click="onAvatar">
        <text class="topbar-avatar-text">{{ avatarText }}</text>
      </view>
    </view>

    <!-- 运行错误提示：出现未捕获异常时不要只留白屏 -->
    <view v-if="errorState.message" class="err-bar">
      <text class="err-text">{{ errorState.message }}</text>
      <text class="err-close" @click="clearError">关闭</text>
    </view>

    <!-- 消息列表 -->
    <scroll-view
      class="messages"
      scroll-y
      :scroll-into-view="scrollTarget"
      :scroll-with-animation="true"
      @scrolltoupper="loadMore"
    >
      <view v-if="!chat.messages.length" class="empty">
        <image class="empty-logo" src="/static/shark.png" mode="aspectFit" />
        <text class="empty-title">我是 DeepTalk，很高兴见到你！</text>
        <text class="empty-hint">可以问问题、读文档，也能一起头脑风暴。</text>
      </view>

      <view class="list-inner">
      <view v-for="(item, index) in chat.messages" :id="`msg-${index}`" :key="item.id || index">
        <MessageItem
          :message="item"
          :activity="chat.activity"
          @regenerate="onRegenerate"
          @rate="(rating) => onRate(item, rating)"
          @retry="onRegenerate"
        />
      </view>
      <view id="msg-end" class="list-end" />
      </view>
    </scroll-view>

    <!-- 输入框 -->
    <view class="composer-wrap">
    <Composer
      v-model="draft"
      :generating="chat.generating"
      :model-name="modelName"
      @send="onSend"
      @stop="onStop"
      @attach="pickImage"
      @pick-model="pickModel"
    />
    </view>

    <!-- H5 端模型选择：Vant Popup + Picker（小程序与 APP 用原生 ActionSheet） -->
    <!-- #ifdef H5 -->
    <van-popup v-model:show="modelPickerOpen" position="bottom" round>
      <van-picker
        :columns="modelColumns"
        title="选择模型"
        @confirm="onModelConfirm"
        @cancel="modelPickerOpen = false"
      />
    </van-popup>
    <!-- #endif -->

    <!-- 历史会话抽屉 -->
    <view v-if="drawerOpen" class="drawer-mask" @click="drawerOpen = false">
      <view class="drawer" @click.stop>
        <view class="drawer-head">
          <image class="drawer-logo" src="/static/shark.png" mode="aspectFit" />
          <text class="drawer-brand">DeepTalk</text>
          <view class="drawer-collapse" @click="drawerOpen = false">
            <view class="bar" />
            <view class="bar" />
          </view>
        </view>

        <view class="drawer-new" @click="newChat">
          <text class="drawer-new-plus">＋</text>
          <text class="drawer-new-text">新建对话</text>
        </view>

        <view class="drawer-search">
          <view class="drawer-search-icon">
            <view class="search-ring" />
            <view class="search-handle" />
          </view>
          <input
            v-model="keyword"
            class="drawer-search-input"
            placeholder="搜索对话"
            placeholder-class="drawer-search-placeholder"
            confirm-type="search"
            @confirm="onSearch"
          />
        </view>

        <scroll-view class="drawer-list" scroll-y>
          <text v-if="chat.conversations.length" class="drawer-group">今天</text>
          <view
            v-for="item in chat.conversations"
            :key="item.id"
            class="drawer-item"
            :class="{ 'drawer-item-on': chat.current && chat.current.id === item.id }"
            @click="openItem(item)"
            @longpress="onItemLongPress(item)"
          >
            <view class="drawer-item-dot" />
            <text class="drawer-item-title">{{ item.title }}</text>
            <view class="dots" @click.stop="onItemLongPress(item)">
              <view class="dot" />
              <view class="dot" />
              <view class="dot" />
            </view>
          </view>
          <text v-if="!chat.conversations.length" class="drawer-empty">还没有对话</text>
        </scroll-view>

        <view class="drawer-usage">
          <view class="drawer-usage-head">
            <text class="drawer-usage-title">本月用量</text>
            <text class="drawer-usage-percent">{{ usageLabel }}</text>
          </view>
          <view class="drawer-usage-track">
            <view class="drawer-usage-fill" :style="{ width: `${usagePercent}%` }" />
          </view>
          <view class="drawer-usage-meta">
            <text class="drawer-usage-tokens">{{ usageTokens }}</text>
            <text class="drawer-usage-reset">{{ usageReset }}</text>
          </view>
        </view>

        <view class="drawer-account" @click="onAvatar">
          <view class="drawer-avatar">
            <text class="drawer-avatar-text">{{ avatarText }}</text>
          </view>
          <view class="drawer-account-main">
            <text class="drawer-account-name">{{ accountName }}</text>
            <text class="drawer-account-mail">{{ accountMail }}</text>
          </view>
          <view class="dots">
            <view class="dot" />
            <view class="dot" />
            <view class="dot" />
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup>
/**
 * 聊天主页面：消息流、输入框、历史会话抽屉。
 * 生成走 WebSocket；与 Web 端共享同一套后端接口与事件。
 */
import { computed, ref, nextTick, onMounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import MessageItem from '@/components/message-item.nvue'
import Composer from '@/components/composer.nvue'
import {
  chat,
  currentTitle,
  loadConversations,
  loadModels,
  loadUsage,
  openConversation,
  startDraft,
  send,
  stop,
  regenerate,
  rate,
  shareCurrent,
  removeConversation,
  rename,
  selectModel,
} from '@/store/chat'
import { chatSocket } from '@/utils/ws'
import { uploadFile } from '@/api/http'
import { session, clearSession } from '@/store/session'
import { errorState, clearError } from '@/utils/errors'
import { toast, confirm } from '@/utils/ui'
import { logout as logoutApi } from '@/api/auth'

const draft = ref('')
const keyword = ref('')
const drawerOpen = ref(false)
const scrollTarget = ref('')
const attachments = ref([])

const modelName = computed(() => chat.models.find((item) => item.id === chat.modelId)?.display_name || '选择模型')
const modelPickerOpen = ref(false)
const modelColumns = computed(() => chat.models.map((item) => ({ text: item.display_name, value: item.id })))

const avatarText = computed(() => session.user?.avatar_text || session.user?.nickname?.slice(0, 1) || 'U')
const accountName = computed(() => session.user?.nickname || '用户')
const accountMail = computed(() => session.user?.email || '')
const usagePercent = computed(() => {
  const usage = chat.usage
  if (!usage) return 0
  if (usage.quota_tokens > 0) return Math.min(100, Math.round((usage.used_tokens / usage.quota_tokens) * 100))
  return Math.min(100, usage.used_percent || 0)
})
const usageLabel = computed(() => (chat.usage?.quota_tokens ? `${usagePercent.value}%` : '不限'))
const usageTokens = computed(() => {
  const usage = chat.usage
  if (!usage) return '—'
  const fmt = (n) => (n >= 1000000 ? `${(n / 1000000).toFixed(1)}M` : n >= 1000 ? `${Math.round(n / 1000)}K` : String(n))
  return usage.quota_tokens ? `${fmt(usage.used_tokens)} / ${fmt(usage.quota_tokens)} tokens` : `${fmt(usage.used_tokens)} tokens`
})
const usageReset = computed(() => (chat.usage?.reset_days ? `重置 ${chat.usage.reset_days} 天` : '不设月度上限'))

function scrollToBottom() {
  nextTick(() => {
    scrollTarget.value = ''
    setTimeout(() => {
      scrollTarget.value = 'msg-end'
    }, 30)
  })
}

async function onSend() {
  const content = draft.value
  if (chat.generating) return
  if (!content.trim() && !attachments.value.length) return
  draft.value = ''
  try {
    await send(content, attachments.value.map((item) => item.id))
    attachments.value = []
    scrollToBottom()
  } catch (err) {
    toast(err?.message || '发送失败')
  }
}

function onStop() {
  stop()
}

function onRegenerate() {
  regenerate()
  scrollToBottom()
}

async function onRate(message, rating) {
  try {
    await rate(message, rating)
  } catch {
    toast('操作失败')
  }
}

/** 侧栏搜索。 */
function onSearch() {
  loadConversations(keyword.value.trim()).catch(() => {})
}

/** 顶栏头像 / 侧栏账号行：分享、退出登录。 */
function onAvatar() {
  uni.showActionSheet({
    itemList: ['分享当前对话', '退出登录'],
    success: (res) => {
      if (res.tapIndex === 0) onShare()
      if (res.tapIndex === 1) logout()
    },
  })
}

function newChat() {
  startDraft()
  drawerOpen.value = false
}

async function openItem(item) {
  drawerOpen.value = false
  await openConversation(item.public_id || item.id)
  scrollToBottom()
}

function onItemLongPress(item) {
  uni.showActionSheet({
    itemList: ['重命名', '删除'],
    success: async (res) => {
      if (res.tapIndex === 1) {
        const ok = await confirm('删除对话', `确定删除「${item.title}」吗？`)
        if (!ok) return
        await removeConversation(item.id)
        toast('已删除')
        return
      }
      uni.showModal({
        title: '重命名',
        editable: true,
        placeholderText: item.title,
        success: async (input) => {
          if (!input.confirm || !input.content) return
          await rename(item.id, input.content)
        },
      })
    },
  })
}

function pickImage() {
  uni.chooseImage({
    count: 4,
    success: async (res) => {
      for (const path of res.tempFilePaths) {
        try {
          const attachment = await uploadFile(path)
          attachments.value.push(attachment)
          toast('图片已添加')
        } catch (err) {
          toast(err.message || '上传失败')
        }
      }
    },
  })
}

function pickModel() {
  if (!chat.models.length) {
    toast('暂无可用模型')
    return
  }
  // #ifdef H5
  modelPickerOpen.value = true
  // #endif
  // #ifndef H5
  uni.showActionSheet({
    itemList: chat.models.map((item) => item.display_name),
    success: (res) => {
      selectModel(chat.models[res.tapIndex].id)
    },
  })
  // #endif
}

/** H5 端 Vant Picker 确认。 */
function onModelConfirm({ selectedOptions }) {
  const picked = selectedOptions?.[0]
  if (picked) selectModel(picked.value)
  modelPickerOpen.value = false
}

async function onShare() {
  if (!chat.current?.public_id) {
    toast('先聊两句再分享')
    return
  }
  try {
    const url = await shareCurrent()
    toast(url ? '分享链接已复制' : '分享失败')
  } catch {
    toast('分享失败')
  }
}

async function logout() {
  try {
    await logoutApi()
  } catch {
    // 忽略登出接口异常，本地清理即可
  }
  chatSocket.close()
  clearSession()
  drawerOpen.value = false
  uni.reLaunch({ url: '/pages/login/login' })
}

function loadMore() {
  // 占位：历史消息分页由服务端一次返回
}

onMounted(async () => {
  chatSocket.connect()
  await Promise.all([loadModels(), loadConversations(), loadUsage()])
  if (chat.conversations.length) {
    await openItem(chat.conversations[0])
  }
})

onShow(() => {
  chatSocket.connect()
})
</script>

<style>
