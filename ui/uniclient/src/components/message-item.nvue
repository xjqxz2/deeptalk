<template>
  <view class="msg" :class="message.role === 'user' ? 'msg-user' : 'msg-assistant'">
    <!-- 用户消息：右侧气泡 + 时间 -->
    <block v-if="message.role === 'user'">
      <view v-if="message.attachments && message.attachments.length" class="user-images">
        <image
          v-for="item in message.attachments"
          :key="item.id"
          class="user-image"
          :src="item.url"
          mode="aspectFill"
        />
      </view>
      <view v-if="message.content" class="bubble">
        <text class="bubble-text">{{ message.content }}</text>
      </view>
      <text class="msg-time">{{ time }}</text>
    </block>

    <!-- 助手消息 -->
    <block v-else>
      <view class="head">
        <image class="head-logo" src="/static/shark.png" mode="aspectFit" />
        <text class="head-name">小橘树洞</text>
        <text class="head-model">{{ message.model_name || 'DeepSeek' }}</text>
      </view>

      <ThinkingPanel
        v-if="message.reasoning || (streaming && activity) || viewedSources.length"
        :reasoning="message.reasoning"
        :streaming="streaming"
        :duration-ms="message.duration_ms || 0"
        :activity="activity"
        :sources="message.sources"
      />

      <A2uiRenderer
        v-if="message.a2ui && message.a2ui.length"
        :messages="message.a2ui"
        @action="$emit('a2ui-action', $event)"
      />

      <view v-if="message.notice" class="notice">
        <text class="notice-text">{{ message.notice }}</text>
      </view>

      <view v-if="blocks.length" class="blocks">
        <view v-for="(block, index) in blocks" :key="index" class="block">
          <text v-if="block.type === 'heading'" class="h1">
            <text v-for="(span, si) in block.spans" :key="si" :class="spanClass(span)">{{ span.text }}</text>
          </text>

          <text v-else-if="block.type === 'quote'" class="quote">
            <text v-for="(span, si) in block.spans" :key="si" :class="spanClass(span)">{{ spanText(span) }}</text>
          </text>

          <view v-else-if="block.type === 'list'" class="list">
            <view v-for="(item, li) in block.items" :key="li" class="list-item">
              <text class="list-bullet">{{ block.ordered ? `${li + 1}.` : '•' }}</text>
              <text class="list-text">
                <text v-for="(span, si) in item.spans" :key="si" :class="spanClass(span)">{{ spanText(span) }}</text>
              </text>
            </view>
          </view>

          <view v-else-if="block.type === 'code'" class="code">
            <view class="code-head">
              <text class="code-lang">{{ block.language }}</text>
              <text class="code-copy" @click="copy(block.code)">复制</text>
            </view>
            <scroll-view class="code-body" scroll-x>
              <text class="code-text">{{ block.code }}</text>
            </scroll-view>
          </view>

          <text v-else class="paragraph">
            <text v-for="(span, si) in block.spans" :key="si" :class="spanClass(span)">{{ spanText(span) }}</text>
          </text>
        </view>
      </view>

      <text v-else-if="streaming" class="typing">正在生成…</text>

      <view v-if="message.error" class="error">
        <text class="error-text">{{ message.error }}</text>
        <text class="error-retry" @click="$emit('retry')">重试</text>
      </view>

      <view v-if="!streaming && hasActions" class="actions">
        <text class="action" @click="copy(message.content)">复制</text>
        <text v-if="showRegenerate" class="action" @click="$emit('regenerate')">重新生成</text>
        <text class="action" :class="{ 'action-on': message.feedback === 'up' }" @click="$emit('rate', 'up')">赞</text>
        <text class="action" :class="{ 'action-on': message.feedback === 'down' }" @click="$emit('rate', 'down')">踩</text>
        <text class="action-meta">{{ meta }}</text>
      </view>
    </block>
  </view>
</template>

<script setup>
/**
 * 单条消息，样式与 Web 端手机视口保持一致：
 * 用户右侧气泡 + 时间；助手为整块正文，含思维链、Markdown 块与操作栏。
 */
import { computed } from 'vue'
import ThinkingPanel from './thinking-panel.nvue'
import A2uiRenderer from './a2ui/renderer.nvue'
import { parseMarkdown } from '@/utils/markdown'

const props = defineProps({
  message: { type: Object, required: true },
  activity: { type: Object, default: null },
  showRegenerate: { type: Boolean, default: true },
})
defineEmits(['regenerate', 'rate', 'retry', 'a2ui-action'])

const streaming = computed(() => props.message.status === 'streaming')
const blocks = computed(() => (props.message.content ? parseMarkdown(props.message.content) : []))
const viewedSources = computed(() => (props.message.sources || []).filter((item) => item.viewed))
const hasActions = computed(() => Boolean(props.message.content))

/** 用户消息时间，形如 10:00。 */
const time = computed(() => {
  const raw = props.message.created_at
  if (!raw) return ''
  const date = new Date(raw)
  if (Number.isNaN(date.getTime())) return ''
  return `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`
})

/** 生成信息：已生成 N 字 · N tok/s，与 Web 端一致。 */
const meta = computed(() => {
  const chars = (props.message.content || '').replace(/\s/g, '').length
  if (!chars) return ''
  const tokens = props.message.output_tokens || 0
  const duration = props.message.duration_ms || 0
  const speed = tokens && duration ? Math.max(1, Math.round(tokens / (duration / 1000))) : 0
  return speed ? `已生成 ${chars} 字 · ${speed} tok/s` : `已生成 ${chars} 字`
})

function spanClass(span) {
  if (span.bold) return 'span-bold'
  if (span.code) return 'span-code'
  if (span.cite) return 'span-cite'
  return 'span'
}

const SUPERSCRIPT = { 0: '⁰', 1: '¹', 2: '²', 3: '³', 4: '⁴', 5: '⁵', 6: '⁶', 7: '⁷', 8: '⁸', 9: '⁹' }

/** 引用标号渲染成上标数字（nvue 不支持 vertical-align，用上标字符实现）。 */
function spanText(span) {
  if (!span.cite) return span.text
  return span.text.replace(/[[\]]/g, '').replace(/[0-9]/g, (digit) => SUPERSCRIPT[digit] || digit)
}

function copy(text) {
  if (!text) return
  uni.setClipboardData({ data: text })
}
</script>

<style>
.msg {
  padding: 16rpx 0 36rpx 0;
}
.msg-user {
  align-items: flex-end;
}
.msg-assistant {
  align-items: stretch;
}
.user-images {
  flex-direction: row;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}
.user-image {
  width: 200rpx;
  height: 150rpx;
  margin-left: 12rpx;
  border-radius: 12rpx;
}
.bubble {
  max-width: 78%;
  padding: 22rpx 32rpx;
  border-radius: 28rpx;
  background-color: #f3f5fa;
}
.bubble-text {
  color: #101828;
  font-size: 27rpx;
  line-height: 46rpx;
}
.msg-time {
  margin-top: 12rpx;
  color: #98a2b3;
  font-size: 20rpx;
}
.head {
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}
.head-logo {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 14rpx;
}
.head-name {
  color: #101828;
  font-size: 26rpx;
  font-weight: 650;
}
.head-model {
  margin-left: 12rpx;
  color: #98a2b3;
  font-size: 21rpx;
}
.blocks {
  margin-top: 6rpx;
}
.block {
  margin-bottom: 18rpx;
}
.paragraph {
  color: #101828;
  font-size: 27rpx;
  line-height: 48rpx;
}
.h1 {
  color: #101828;
  font-size: 34rpx;
  font-weight: bold;
  line-height: 48rpx;
}
.quote {
  padding-left: 20rpx;
  border-left-width: 4rpx;
  border-left-style: solid;
  border-left-color: #d0d5dd;
  color: #475467;
  font-size: 29rpx;
  line-height: 46rpx;
}
.list {
  margin-top: 4rpx;
}
.list-item {
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.list-bullet {
  width: 32rpx;
  color: #101828;
  font-size: 27rpx;
  line-height: 48rpx;
}
.list-text {
  flex: 1;
  color: #101828;
  font-size: 27rpx;
  line-height: 48rpx;
}
.code {
  margin-top: 8rpx;
  border-radius: 18rpx;
  background-color: #14161c;
}
.code-head {
  flex-direction: row;
  justify-content: space-between;
  padding: 18rpx 24rpx;
}
.code-lang {
  color: #e4e7ec;
  font-size: 26rpx;
}
.code-copy {
  color: #c0c5d0;
  font-size: 26rpx;
}
.code-body {
  padding: 0 24rpx 20rpx 24rpx;
}
.code-text {
  color: #e6e8ee;
  font-size: 26rpx;
  line-height: 40rpx;
  font-family: Menlo, monospace;
}
.span {
  color: #101828;
  font-size: 27rpx;
  line-height: 48rpx;
}
.span-bold {
  color: #101828;
  font-size: 27rpx;
  font-weight: bold;
  line-height: 48rpx;
}
.span-code {
  color: #b42318;
  font-size: 27rpx;
  font-family: Menlo, monospace;
}
.span-cite {
  color: #4d6bfe;
  font-size: 22rpx;
}
.typing {
  color: #98a2b3;
  font-size: 27rpx;
}
.notice {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background-color: #fffaeb;
}
.notice-text {
  color: #b54708;
  font-size: 25rpx;
}
.error {
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background-color: #fef3f2;
}
.error-text {
  flex: 1;
  color: #b42318;
  font-size: 26rpx;
}
.error-retry {
  margin-left: 16rpx;
  color: #b42318;
  font-size: 26rpx;
}
.actions {
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
}
.action {
  margin-right: 32rpx;
  color: #98a2b3;
  font-size: 21rpx;
}
.action-on {
  color: #4d6bfe;
}
.action-meta {
  flex: 1;
  text-align: right;
  color: #d0d5dd;
  font-size: 20rpx;
}

@media (prefers-color-scheme: dark) {
  .bubble {
    background-color: #23272f;
  }
  .bubble-text,
  .paragraph,
  .span {
    color: #e6e9ef;
  }
  .head-name,
  .h1,
  .span-bold {
    color: #f2f4f8;
  }
  .head-model,
  .msg-time,
  .typing,
  .action,
  .action-meta {
    color: #7b8494;
  }
  .list-bullet,
  .list-text,
  .quote {
    color: #c9cfda;
  }
  .code {
    background-color: #0d0f14;
  }
  .code-head {
    border-bottom-color: #23272f;
  }
  .notice {
    background-color: #33260f;
  }
  .notice-text {
    color: #fcd34d;
  }
  .error {
    background-color: #3a1a1c;
  }
  .error-text,
  .error-retry {
    color: #fca5a5;
  }
}
</style>
