<template>
  <view class="think">
    <view class="think-head" @click="toggle">
      <view class="think-dot" />
      <text class="think-label">{{ label }}</text>
      <text class="think-toggle">{{ expanded ? '收起' : '展开' }}</text>
      <view class="think-chevron" :class="{ 'think-chevron-up': expanded }" />
    </view>

    <view v-if="expanded" class="think-body">
      <text v-if="reasoning" class="think-text">{{ reasoning }}</text>
      <view v-if="viewed.length" class="think-sources">
        <text v-for="(item, index) in viewed" :key="index" class="think-source" @click="openSource(item)">
          · {{ item.title || item.url }}
        </text>
      </view>
    </view>
  </view>
</template>

<script setup>
/**
 * 深度思考折叠面板，样式对齐 Web 端：
 * 圆角浅灰卡片、星标图标、右侧「展开 / 收起」，展开后展示推理与看过的网页。
 */
import { computed, ref, watch } from 'vue'

const props = defineProps({
  reasoning: { type: String, default: '' },
  streaming: { type: Boolean, default: false },
  durationMs: { type: Number, default: 0 },
  activity: { type: Object, default: null },
  sources: { type: Array, default: () => [] },
})

const expanded = ref(false)

watch(
  () => props.streaming,
  (value) => {
    if (value) expanded.value = true
  },
  { immediate: true },
)

const seconds = computed(() => {
  if (props.durationMs > 0) return Math.max(1, Math.round(props.durationMs / 1000))
  return Math.max(2, Math.ceil(props.reasoning.length / 12))
})

const label = computed(() => {
  if (props.streaming) return props.activity?.label || '正在思考…'
  return `已思考 ${seconds.value} 秒`
})

const viewed = computed(() => props.sources.filter((item) => item.viewed))

function toggle() {
  expanded.value = !expanded.value
}

function openSource(item) {
  if (!item.url) return
  // #ifdef H5
  window.open(item.url, '_blank')
  // #endif
  // #ifndef H5
  uni.setClipboardData({ data: item.url })
  // #endif
}
</script>

<style>
.think {
  margin: 6rpx 0 20rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background-color: #f7f9fc;
  border-width: 1rpx;
  border-style: solid;
  border-color: #eef1f6;
}
.think-head {
  flex-direction: row;
  align-items: center;
}
.think-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 7rpx;
  background-color: #4d6bfe;
}
.think-label {
  flex: 1;
  color: #475467;
  font-size: 27rpx;
}
.think-toggle {
  color: #98a2b3;
  font-size: 25rpx;
}
.think-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  margin-bottom: 4rpx;
  border-right-width: 2rpx;
  border-right-style: solid;
  border-right-color: #98a2b3;
  border-bottom-width: 2rpx;
  border-bottom-style: solid;
  border-bottom-color: #98a2b3;
  transform: rotate(45deg);
}
.think-chevron-up {
  margin-bottom: -4rpx;
  transform: rotate(-135deg);
}
.think-body {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: #eef1f6;
}
.think-text {
  color: #667085;
  font-size: 26rpx;
  line-height: 42rpx;
}
.think-sources {
  margin-top: 14rpx;
}
.think-source {
  margin-bottom: 8rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 36rpx;
}
</style>
