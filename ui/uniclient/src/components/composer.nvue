<template>
  <view class="composer">
    <view class="composer-box" @click="focusInput">
      <textarea
        :key="inputKey"
        class="composer-input"
        :value="modelValue"
        :placeholder="generating ? '生成中可以插话，会在这一轮结束后处理…' : '继续追问，或让 小橘树洞 补充更多细节…'"
        placeholder-class="composer-placeholder"
        :maxlength="8000"
        auto-height
        :adjust-position="true"
        confirm-type="send"
        @input="onInput"
        @keydown="onKeydown"
        @confirm="$emit('send')"
      />

      <view class="composer-tools">
        <text class="tool-icon" @click="$emit('attach')">附件</text>
        <text class="tool-model" @click="$emit('pick-model')">{{ modelName }}</text>
        <view class="tool-chevron" @click="$emit('pick-model')" />
        <view class="send-btn-slot">
          <view v-if="generating" class="stop-inline" @click="$emit('stop')">
            <text class="stop-inline-text">停止</text>
          </view>
          <view
            class="send-btn"
            :class="{ 'send-btn-off': !canSend, 'send-btn-interject': generating }"
            @click="$emit('send')"
          >
            <text class="send-icon">{{ generating ? '插' : '↑' }}</text>
          </view>
        </view>
      </view>
    </view>
    <text class="composer-tip">内容由 AI 生成，请仔细甄别</text>
  </view>
</template>

<script setup>
/** 输入框：自动增高、附件、模型选择、圆形发送/停止按钮，样式对齐 Web 端手机视口。 */
import { computed, ref, watch } from 'vue'

const props = defineProps({
  modelValue: { type: String, default: '' },
  generating: { type: Boolean, default: false },
  modelName: { type: String, default: '选择模型' },
})
const emit = defineEmits(['update:modelValue', 'send', 'stop', 'attach', 'pick-model'])

const canSend = computed(() => Boolean(props.modelValue && props.modelValue.trim()))

// 输入框的即时值：props 更新有一帧延迟，回车时要拿到真实内容
const localValue = ref(props.modelValue || '')

// 清空时换一个 key 重建 textarea：uni 的 textarea 聚焦时不会跟随 props 清空 DOM 值
const inputKey = ref(0)

watch(
  () => props.modelValue,
  (value) => {
    if (value === localValue.value) return
    localValue.value = value || ''
    // 发送后 props 变成空串：重建 textarea，确保界面真的清空
    if (!value) inputKey.value += 1
  },
)

/** 当前输入内容：H5 直接读 DOM，最可靠。 */
function currentValue() {
  // #ifdef H5
  const box = document.querySelector('.composer-box')
  const field = box && box.querySelector('textarea')
  if (field) return field.value
  // #endif
  return localValue.value
}

// 整块输入区可点：点空白处也能聚焦到输入框（否则只有文字那一行能点）
/** 点输入框空白处也能聚焦。直接用原生 focus，不走响应式 prop（否则会自激）。 */
function focusInput() {
  // #ifdef H5
  const box = document.querySelector('.composer-box')
  const field = box && box.querySelector('textarea')
  if (field && document.activeElement !== field) field.focus()
  // #endif
}

function onInput(event) {
  localValue.value = event.detail.value
  emit('update:modelValue', event.detail.value)
}

/**
 * H5 / 桌面端：Enter 发送，Shift+Enter 换行。
 * 小程序没有真实键盘事件，走 textarea 的 confirm-type="send"。
 */
function onKeydown(event) {
  const key = event?.key
  if (key !== 'Enter' || event.shiftKey || event.isComposing) return
  if (event.preventDefault) event.preventDefault()
  const value = currentValue()
  if (value && value.trim()) emit('send', value)
}
</script>

<style>
.composer {
  padding: 12rpx 32rpx 20rpx 32rpx;
  background-color: #ffffff;
}
.composer-box {
  padding: 26rpx 30rpx 22rpx 30rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  border-width: 1rpx;
  border-style: solid;
  border-color: #e4e7ee;
}
.composer-input {
  width: 100%;
  min-height: 48rpx;
  max-height: 384rpx;
  flex-shrink: 0;
  color: #101828;
  font-size: 27rpx;
  line-height: 48rpx;
}
.composer-placeholder {
  color: #98a2b3;
}
.composer-tools {
  flex-direction: row;
  align-items: center;
  margin-top: 14rpx;
}
.tool-icon {
  width: 64rpx;
  flex-shrink: 0;
  color: #667085;
  font-size: 24rpx;
}
.tool-model {
  width: 0;
  flex: 1;
  flex-shrink: 1;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
  color: #475467;
  font-size: 23rpx;
  font-weight: 620;
}
.tool-chevron {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
  border-right-width: 2rpx;
  border-right-style: solid;
  border-right-color: #98a2b3;
  border-bottom-width: 2rpx;
  border-bottom-style: solid;
  border-bottom-color: #98a2b3;
  transform: rotate(45deg);
}
.send-btn-slot {
  /* nvue 默认是纵向 flex：这里必须显式横排，否则「停止」和「插」会上下叠在一起 */
  flex-direction: row;
  align-items: center;
  width: auto;
  flex-shrink: 0;
}
.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  align-items: center;
  justify-content: center;
  background-color: #4d6bfe;
}
.send-btn-off {
  background-color: #dbe3ff;
}
.send-btn-stop {
  background-color: #101828;
}
.send-icon {
  color: #ffffff;
  font-size: 28rpx;
}
.composer-tip {
  margin-top: 12rpx;
  text-align: center;
  color: #c0c5d0;
  font-size: 20rpx;
}

@media (prefers-color-scheme: dark) {
  .composer {
    background-color: #171a21;
  }
  .composer-box {
    background-color: #191c23;
    border-color: #2a2f3a;
  }
  .composer-input {
    color: #e6e9ef;
  }
  .composer-placeholder {
    color: #7b8494;
  }
  .tool-icon,
  .tool-model {
    color: #b6bdcb;
  }
  .tool-chevron {
    border-right-color: #7b8494;
    border-bottom-color: #7b8494;
  }
  .composer-tip {
    color: #5c6472;
  }
}
.send-btn-interject {
  background-color: #eef2ff;
}
.send-btn-interject .send-icon {
  color: #4d6bfe;
  font-size: 24rpx;
}
.stop-inline {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background-color: #f2f4f7;
}
.stop-inline-text {
  color: #475467;
  font-size: 24rpx;
}
</style>
