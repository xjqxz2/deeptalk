.composer {
  padding: 16rpx 24rpx 24rpx 24rpx;
  background-color: #ffffff;
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: #f0f2f5;
}
.composer-box {
  padding: 20rpx 24rpx 16rpx 24rpx;
  border-radius: 26rpx;
  background-color: #f7f8fa;
  border-width: 1rpx;
  border-style: solid;
  border-color: #e4e7ec;
}
.composer-input {
  width: 100%;
  min-height: 76rpx;
  max-height: 300rpx;
  color: #101828;
  font-size: 30rpx;
  line-height: 44rpx;
}
.composer-placeholder {
  color: #98a2b3;
}
.composer-tools {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.tool-left {
  flex-direction: row;
  align-items: center;
}
.tool-icon {
  width: 56rpx;
  color: #667085;
  font-size: 34rpx;
}
.tool-model {
  color: #475467;
  font-size: 25rpx;
}
.send-btn {
  padding: 12rpx 30rpx;
  border-radius: 20rpx;
  background-color: #4d6bfe;
}
.send-btn-off {
  background-color: #c7d2fe;
}
.send-btn-stop {
  background-color: #101828;
}
.send-text {
  color: #ffffff;
  font-size: 26rpx;
}
.composer-tip {
  margin-top: 12rpx;
  text-align: center;
  color: #d0d5dd;
  font-size: 22rpx;
}
</style>
