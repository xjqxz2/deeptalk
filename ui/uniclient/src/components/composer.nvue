<template>
  <view class="composer">
    <view class="composer-box">
      <textarea
        class="composer-input"
        :value="modelValue"
        :disabled="generating"
        placeholder="继续追问，或让 DeepTalk 补充更多细节…"
        placeholder-class="composer-placeholder"
        :maxlength="8000"
        auto-height
        :adjust-position="true"
        confirm-type="send"
        @input="onInput"
        @confirm="$emit('send')"
      />

      <view class="composer-tools">
        <view class="tool-left">
          <text class="tool-icon" @click="$emit('attach')">＋</text>
          <text class="tool-model" @click="$emit('pick-model')">{{ modelName }}</text>
        </view>
        <view v-if="generating" class="send-btn send-btn-stop" @click="$emit('stop')">
          <text class="send-text">停止</text>
        </view>
        <view v-else class="send-btn" :class="{ 'send-btn-off': !canSend }" @click="$emit('send')">
          <text class="send-text">发送</text>
        </view>
      </view>
    </view>
    <text class="composer-tip">内容由 AI 生成，请仔细甄别</text>
  </view>
</template>

<script setup>
/** 输入框：自动增高、模型选择、附件、发送 / 停止。 */
import { computed } from 'vue'

const props = defineProps({
  modelValue: { type: String, default: '' },
  generating: { type: Boolean, default: false },
  modelName: { type: String, default: '选择模型' },
})
const emit = defineEmits(['update:modelValue', 'send', 'stop', 'attach', 'pick-model'])

const canSend = computed(() => Boolean(props.modelValue && props.modelValue.trim()))

function onInput(event) {
  emit('update:modelValue', event.detail.value)
}
</script>

