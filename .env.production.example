# 复制到服务器 /opt/deeptalk/.env 后修改；不要提交到 Git。
DEEPTALK_IMAGE=ghcr.io/owner/repo
DEEPTALK_IMAGE_TAG=v1.0.0

# 首次启动后不要再改，否则已加密的厂商 Key 无法解密
DEEPTALK_SECRET=please-change-me-to-a-fixed-long-random-string

DEEPTALK_BASE_URL=https://your-domain.example.com
DEEPTALK_PORT=9821
DEEPTALK_DATA_DIR=/opt/deeptalk/data

DEEPTALK_DEEPSEEK_KEY=sk-...
DEEPTALK_MAX_OUTPUT_TOKENS=384000
DEEPTALK_REASONING_EFFORT=medium

# HTTPS 反向代理时使用
DEEPTALK_ENV=prod
DEEPTALK_COOKIE_SECURE=true

TZ=Asia/Shanghai
