# 生产部署：复制到 /srv/deeptalk/.env 后修改，不要提交到 Git。
# 由 docker compose 读取；Go 进程本身只认 DEEPTALK_* 覆盖项。

# ── 镜像 ─────────────────────────────────────────
DEEPTALK_IMAGE=ghcr.nju.edu.cn/xjqxz2/deeptalk
DEEPTALK_IMAGE_TAG=latest

# ── 必填 ─────────────────────────────────────────
# 首次启动后不要再改，否则已加密的厂商 Key 无法解密
DEEPTALK_SECRET=please-change-me-to-a-fixed-long-random-string
DEEPTALK_BASE_URL=https://your-domain.example.com

# 宿主机数据目录（挂载到容器 /app/data）
DEEPTALK_DATA_DIR=/srv/deeptalk/data
# 宿主机映射端口
DEEPTALK_PORT=9821

# ── 运行 ─────────────────────────────────────────
# HTTPS 反向代理必须 prod + true
DEEPTALK_ENV=prod
DEEPTALK_COOKIE_SECURE=true
# 拒绝未签名的写请求
DEEPTALK_SIGN_MODE=enforce

# ── 其它（一般用 app.yaml 默认值即可）─────────────
# DEEPTALK_REASONING_EFFORT=medium
# DEEPTALK_MCP_ENABLED=true
# DEEPTALK_MCP_COMMAND=obscura
# DEEPTALK_SEARCH_HTTP_FALLBACK=true

TZ=Asia/Shanghai
