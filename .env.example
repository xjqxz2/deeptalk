# 复制为 .env 后再修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密钥。

# 会话/API Key 加密密钥，至少 16 位；生成示例：openssl rand -hex 32
# 重要：首次启动后不要再改，否则数据库里的厂商 Key 无法解密。
DEEPTALK_SECRET=please-change-me-to-a-random-string-at-least-32-chars

# 对外访问地址；局域网访问请改成实际 IP 或域名
DEEPTALK_BASE_URL=http://localhost:9821
DEEPTALK_PORT=9821

# 首次空库时 seed 的官方 DeepSeek Key；不填则走无 Key 演示模式
DEEPTALK_DEEPSEEK_KEY=

# 单次输出预算（thinking + 正文共用），默认 384K
DEEPTALK_MAX_OUTPUT_TOKENS=384000
DEEPTALK_REASONING_EFFORT=medium

# 本地 HTTP 保持 dev；HTTPS 反向代理再改为 prod + true
DEEPTALK_ENV=dev
DEEPTALK_COOKIE_SECURE=false

TZ=Asia/Shanghai
