# 本地开发用的环境变量样例：cp .env.example .env
# 说明：app.yaml 是唯一配置源，这里只是「覆盖层」，留空即用 app.yaml 的默认值。
# 只有敏感项（密钥）才必须放这里；其它建议直接改 server/configs/app.yaml。

# ── 必填 ─────────────────────────────────────────
# 加密厂商 API Key 与会话签名的主密钥，至少 16 位；生成：openssl rand -hex 32
# 首次启动后不要再改，改了数据库里已加密的厂商 Key 全部作废。
DEEPTALK_SECRET=please-change-me-to-a-random-string-at-least-32-chars

# ── 基础 ─────────────────────────────────────────
DEEPTALK_ENV=dev
DEEPTALK_BASE_URL=http://localhost:9821
# 监听地址（写成 0.0.0.0:9821 才能被局域网访问）
# DEEPTALK_ADDR=0.0.0.0:9821
# IP 定位失败时的兜底位置与时区
# DEEPTALK_LOCATION=杭州
# DEEPTALK_TIMEZONE=Asia/Shanghai

# ── 数据 ─────────────────────────────────────────
# SQLite 路径（相对 server 目录）；目录会自动创建
# DEEPTALK_DB=data/deeptalk.db
# ── 安全 ─────────────────────────────────────────
# 本地保持 log；生产用 enforce（拒绝未签名写请求）
# DEEPTALK_SIGN_MODE=log
# HTTPS 下必须 true
DEEPTALK_COOKIE_SECURE=false

# ── 上游模型 ─────────────────────────────────────
# 输出预算与生成超时在后台「系统设置」里改（存数据库），不在这里配
# DEEPTALK_REASONING_EFFORT=medium

# ── 联网检索（Obscura 可选，缺失时自动回退普通 HTTP）──
# DEEPTALK_SEARCH_ENABLED=true
# DEEPTALK_OBSCURA_BIN=obscura
# DEEPTALK_SEARCH_HTTP_FALLBACK=true
# DEEPTALK_SEARCH_TIMEOUT_SEC=25
# DEEPTALK_SEARCH_PAGE_TIMEOUT_SEC=15

# ── MCP ──────────────────────────────────────────
# DEEPTALK_MCP_ENABLED=true
# DEEPTALK_MCP_COMMAND=obscura
# DEEPTALK_MCP_TIMEOUT_SEC=30
# 内置 SSH MCP：首次为每个用户生成密钥的 RSA 位数
# DEEPTALK_SSH_KEY_BITS=4096

# ── 小程序（不需要就留空）────────────────────────
# DEEPTALK_WECHAT_APPID=
# DEEPTALK_WECHAT_SECRET=
# DEEPTALK_WECHAT_SECURITY=true
# DEEPTALK_WECHAT_SECURITY_FAIL_CLOSED=false
# DEEPTALK_WECHAT_SECURITY_REQUIRE_BIND=false
# DEEPTALK_WECHAT_TOKEN_BUFFER=300

# ── 上传 ─────────────────────────────────────────
# DEEPTALK_UPLOAD_DIR=data/uploads
# DEEPTALK_UPLOAD_MAX_MB=8

# ── 仅 docker compose 使用（Go 进程不读）─────────
# 宿主机映射端口
# DEEPTALK_PORT=9821
TZ=Asia/Shanghai
